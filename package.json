{
  "name": "medical-audit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.15"
    }
  },
  "scripts": {
    "web:dev": "pnpm --filter medical-audit-web dev",
    "web:build": "pnpm --filter medical-audit-web build",
    "web:build:static": "pnpm --filter medical-audit-web build:static",
    "web:start": "pnpm --filter medical-audit-web start",
    "web:lint": "pnpm --filter medical-audit-web lint",
    "web:typecheck": "pnpm --filter medical-audit-web typecheck",
    "web:test": "pnpm --filter medical-audit-web test",
    "web:e2e": "pnpm --filter medical-audit-web e2e",
    "local:fullstack:e2e": "uv run python scripts/run-local-fullstack-e2e.py",
    "local:postgres:readonly": "uv run python scripts/run-local-fullstack-e2e.py --backend-mode postgres-readonly",
    "local:permission:readonly": "uv run python scripts/run-controlled-api-readonly-permission-smoke.py",
    "auth:sso-contract-readiness": "uv run python scripts/audit-auth-sso-contract-readiness.py",
    "document:governance-contract-readiness": "uv run python scripts/audit-document-governance-contract-readiness.py",
    "document:governance-ready-profile": "uv run python scripts/run-document-governance-ready-profile.py",
    "document:governance-production-readonly-plan": "uv run python scripts/prepare-document-governance-production-readonly-plan.py",
    "document:governance-production-readonly-precheck": "uv run python scripts/run-document-governance-production-readonly-precheck.py",
    "document:governance-production-readonly-coverage": "uv run python scripts/prepare-document-governance-production-readonly-observation-coverage.py",
    "production:permission-readonly": "uv run python scripts/run-controlled-api-readonly-permission-smoke.py --base-url https://audit.lute-tlz-dddd.top --api-prefix /api/v1 --mode observe --json-output tmp/outputs/production-permission-readonly-smoke-latest.json",
    "production:frontend-acceptance": "node scripts/run-production-frontend-acceptance-gate.mjs"
  }
}
