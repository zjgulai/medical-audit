POSTGRES_DB=medical_audit_kb
POSTGRES_USER=medical_audit_kb
POSTGRES_PASSWORD=replace-with-strong-random-password
MEDICAL_AUDIT_KB_DATABASE_URL=postgresql+psycopg://medical_audit_kb:replace-with-strong-random-password@postgres:5432/medical_audit_kb
KIMI_API_KEY=replace-with-runtime-key
MEDICAL_AUDIT_KB_ANSWER_PROVIDER=fallback
MEDICAL_AUDIT_KB_ANSWER_API_KEY_ENV=KIMI_API_KEY
MEDICAL_AUDIT_KB_ANSWER_MODEL=replace-with-verified-chat-model
MEDICAL_AUDIT_KB_ANSWER_BASE_URL=replace-with-provider-base-url
MEDICAL_AUDIT_KB_ANSWER_MAX_OUTPUT_TOKENS=600
MEDICAL_AUDIT_KB_ANSWER_TEMPERATURE=0
MEDICAL_AUDIT_KB_API_SECRET=replace-with-random-api-secret
MEDICAL_AUDIT_KB_ADMIN_API_SECRET=replace-with-different-random-admin-secret
MEDICAL_AUDIT_KB_ALLOW_EXTERNAL_AI=0
MEDICAL_AUDIT_KB_DEV_MODE=0
MEDICAL_AUDIT_ANALYTICS_UPLOAD_ROOT_HOST=/opt/medical-audit/analytics-uploads
MEDICAL_AUDIT_DOCUMENT_UPLOAD_ROOT_HOST=/opt/medical-audit/document-uploads

# Personal-material storage defaults to local retention. Do not switch to
# tencent-cos until the read-only COS bootstrap preflight returns status=pass
# on the production host and a separate deployment approval is recorded.
MEDICAL_AUDIT_DOCUMENT_STORAGE_PROVIDER=local
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_BUCKET=
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_REGION=ap-guangzhou
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_PREFIX=personal-materials/prod
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_SECRET_ID_ENV=COS_SECRET_ID
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_SECRET_KEY_ENV=COS_SECRET_KEY
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_ENCRYPTION=sse-cos
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_STORAGE_CLASS=STANDARD
MEDICAL_AUDIT_DOCUMENT_STORAGE_COS_SDK_BOOTSTRAP=0

# These are secret values referenced by the two *_ENV variables above. Keep them
# only in the remote 600-permission env file; never commit real values.
COS_SECRET_ID=
COS_SECRET_KEY=
MEDICAL_AUDIT_AUDIT_LOG_ARCHIVE_ROOT_HOST=/opt/medical-audit/audit-log-archive
MEDICAL_AUDIT_AUDIT_LOG_ARCHIVE_REPORT_DIR_HOST=/opt/medical-audit/audit-reports
MEDICAL_AUDIT_AUDIT_LOG_SIGNING_SECRET=replace-with-hmac-secret
MEDICAL_AUDIT_AUDIT_LOG_MIN_MANIFEST_COUNT=0
MEDICAL_AUDIT_AUDIT_LOG_ALERT_WEBHOOK_URL=
MEDICAL_AUDIT_AUDIT_LOG_ALERT_TIMEOUT_SECONDS=10
MEDICAL_AUDIT_AUDIT_LOG_SEND_SUCCESS_ALERT=0
MEDICAL_AUDIT_AUDIT_LOG_ALERT_FAIL_ON_ERROR=0
