# Local evidence and browser-smoke artifacts. Keep source-of-truth summaries in
# drafts/ or docs/ when they need to be reviewed or committed.
output/
web/output/
web/web/

# Deployment secrets stay on the target host, never in git.
configs/deploy/tencent-cloud/*.env
!configs/deploy/tencent-cloud/*.env.example

# Local knowledge source materials are large and may contain proprietary data.
data/*
!data/.gitkeep

# Local tool state and planning caches (not production artifacts).
.claude-flow/
.omc/
.omo/
.playwright-cli/
.playwright-mcp/

# Local plan files generated by AI agents (per-session, not part of release).
.kiro/plan/frontend_ai_replica_*
.kiro/plan/knowledge_base_*
.kiro/plan/loop121_*

# Local reference materials and per-session draft analysis files.
ref/
scripts/build-p6d-*.py

# High-volume per-session knowledge-base ingestion analysis drafts (not release artifacts).
drafts/analysis/knowledge-base-*
drafts/analysis/frontend-ai-replica-*
drafts/analysis/reference-replica-*
drafts/analysis/reference-vs-replica-*
drafts/analysis/original-vs-replica-*
